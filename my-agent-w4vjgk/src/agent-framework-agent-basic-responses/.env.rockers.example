# Demostración local con datos ficticios. Copiar a .env junto a main.py.
# Crear data/pedidos_demo.xlsx siguiendo el README.
FOUNDRY_LOCAL_MODEL=phi-4-mini
ROCKERS_LOCAL_ORDERS_MCP=1
ROCKERS_ORDERS_SOURCE=excel
ROCKERS_EXCEL_PATH=data/pedidos_demo.xlsx
ROCKERS_SHEET_TAB=Pedidos
ROCKERS_HEADER_ROW=2
ROCKERS_ENABLE_LEARN_MCP=0

# Para un XLSX propio descargable desde Drive, cambiar la fuente a drive_xlsx
# y configurar el ID. Se lee siempre la primera hoja. No requiere API de Google.
ROCKERS_SHEET_ID=

# Alternativa MCP remoto: dejar vacía para esta demostración local.
# Para habilitarlo, desactivar ROCKERS_LOCAL_ORDERS_MCP y utilizar un servidor
# HTTPS que implemente autorización por cliente. No publicar su token.
ROCKERS_ORDERS_MCP_URL=
ROCKERS_ORDERS_MCP_TOKEN=
