{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate prerequisites",
      "type": "aitk",
      "command": "debug-check-prerequisites",
      "args": {
        "portOccupancy": [
          5680,
          8089
        ]
      }
    },
    {
      "label": "Run Agent/Workflow HTTP Server",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m debugpy --listen 127.0.0.1:5680 main.py",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/my-agent-w4vjgk/src/agent-framework-agent-basic-responses",
        "env": {
          "PORT": "8089"
        }
      },
      "dependsOn": [
        "Validate prerequisites"
      ],
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete|[Rr]unning on|Started server process"
        }
      }
    },
    {
      "label": "Open Agent Inspector",
      "type": "shell",
      "command": "echo '${input:openAgentInspector}'",
      "presentation": {
        "reveal": "never"
      },
      "dependsOn": [
        "Run Agent/Workflow HTTP Server"
      ]
    },
    {
      "label": "Terminate All Tasks",
      "type": "shell",
      "command": "echo ${input:terminate}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openAgentInspector",
      "type": "command",
      "command": "ai-mlstudio.openTestTool",
      "args": {
        "triggeredFrom": "tasks",
        "port": 8089
      }
    },
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}
